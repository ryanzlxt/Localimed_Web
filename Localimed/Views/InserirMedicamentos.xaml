<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Localimed.Views.InserirMedicamentos"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#D8D8D8">

    <Grid RowDefinitions="90,*">

        <Border Grid.Row="0" BackgroundColor="#001240" StrokeThickness="0">
            <Grid Padding="25,0">
                <Label Text="LOCALIMED" TextColor="White" FontSize="36"
                       FontAttributes="Bold" VerticalOptions="Center" />
                <Frame WidthRequest="65" HeightRequest="65" CornerRadius="33"
                       BackgroundColor="White" Padding="5" HasShadow="False"
                       HorizontalOptions="End" VerticalOptions="Center">
                    <Image Source="logopng.png" Aspect="AspectFit" />
                </Frame>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border WidthRequest="1000" HeightRequest="600"
                    BackgroundColor="White" StrokeThickness="0"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
            </Border>

            <VerticalStackLayout WidthRequest="700" Spacing="18"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <Border WidthRequest="450" Padding="8"
                        BackgroundColor="#D9D9D9" Stroke="#9E9E9E"
                        HorizontalOptions="Center">
                    <Label Text="Inserção de Medicamentos"
                           FontSize="26" FontAttributes="Bold"
                           TextColor="Black" HorizontalTextAlignment="Center" />
                </Border>

                <Entry
                    Text="{Binding NomeMedicamento, Mode=TwoWay}"
                    Placeholder="Nome Medicamento"
                    PlaceholderColor="Gray"
                    TextColor="Black"
                    BackgroundColor="White"
                    WidthRequest="560"
                    HeightRequest="48"
                    HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="18" WidthRequest="560">
                    <Entry
                        Text="{Binding QuantidadeMedicamento, Mode=TwoWay}"
                        Keyboard="Numeric"
                        Placeholder="Quantidade"
                        PlaceholderColor="Gray"
                        TextColor="Black"
                        BackgroundColor="White"
                        MaxLength="9"
                        HeightRequest="48" />

                    <Entry
                        Grid.Column="1"
                        Text="{Binding NumeroLote, Mode=TwoWay}"
                        Keyboard="Numeric"
                        Placeholder="N° Lote"
                        PlaceholderColor="Gray"
                        TextColor="Black"
                        BackgroundColor="White"
                        MaxLength="9"
                        HeightRequest="48" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="18" WidthRequest="560">
                    <Picker
                        x:Name="tipoMedicamentoPicker"
                        SelectedItem="{Binding TipoMedicamento, Mode=TwoWay}"
                        Title="Tipo"
                        TitleColor="#404040"
                        TextColor="Black"
                        BackgroundColor="White"
                        HeightRequest="48" />

                    <DatePicker
                        Grid.Column="1"
                        Date="{Binding DataMedicamento, Mode=TwoWay}"
                        Format="dd/MM/yyyy"
                        TextColor="Black"
                        BackgroundColor="White"
                        HeightRequest="48" />
                </Grid>

                <Entry
                    Text="{Binding DosagemMedicamento, Mode=TwoWay}"
                    Keyboard="Numeric"
                    Placeholder="Dosagem (opcional)"
                    PlaceholderColor="Gray"
                    TextColor="Black"
                    BackgroundColor="White"
                    WidthRequest="560"
                    HeightRequest="48"
                    HorizontalOptions="Center" />

                <HorizontalStackLayout HorizontalOptions="End" Spacing="12" WidthRequest="560">
                    <Button Text="VOLTAR"
                            Command="{Binding BotaoVoltar}"
                            WidthRequest="150" HeightRequest="48"
                            CornerRadius="24"
                            BackgroundColor="#808080"
                            TextColor="White" />

                    <Button Text="CONFIRMAR"
                            Command="{Binding BotaoConfirmar}"
                            WidthRequest="180" HeightRequest="48"
                            CornerRadius="24"
                            BackgroundColor="#001240"
                            TextColor="White" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
