<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Localimed.Views.LogPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#001240">

    <Grid ColumnDefinitions="*,1.15*">

        <VerticalStackLayout Grid.Column="0"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="12">
            <Image Source="logopng.png" WidthRequest="360" HeightRequest="220" />
            <Label Text="LOCALIMED"
                   FontSize="48"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Border Grid.Column="1"
                WidthRequest="430"
                HeightRequest="470"
                BackgroundColor="#D9D9D9"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30" />
            </Border.StrokeShape>

            <VerticalStackLayout Padding="35" Spacing="20"
                                 VerticalOptions="Center">
                <Label Text="Identifique-se no LocaliMED"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="Black"
                       HorizontalTextAlignment="Center" />

                <Entry
                    Placeholder="Insira o seu ID"
                    Text="{Binding IdentificacaoUsuario, Mode=TwoWay}"
                    BackgroundColor="White"
                    TextColor="Black"
                    Keyboard="Numeric"
                    HeightRequest="50" />

                <Button
                    Text="Continuar"
                    Command="{Binding BotaoContinuar}"
                    BackgroundColor="#001240"
                    TextColor="White"
                    CornerRadius="24"
                    HeightRequest="50" />

                <Image Source="logo.png"
                       WidthRequest="90"
                       HeightRequest="90"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
