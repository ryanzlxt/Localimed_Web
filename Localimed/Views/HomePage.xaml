<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Localimed.Views.HomePage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#001240">

    <Grid>
        <Border
            BackgroundColor="#BDBDBD"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 15"
            WidthRequest="1000"
            HeightRequest="600"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <VerticalStackLayout
                Padding="80"
                Spacing="25"
                VerticalOptions="Center">

                <Label
                    Text="LOCALIMED"
                    TextColor="#001240"
                    FontSize="42"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />

                <Button
                    Text="Inserir Medicamento"
                    Command="{Binding BotaoInserirMedicamentos}"
                    HeightRequest="75"
                    CornerRadius="18"
                    BackgroundColor="White"
                    TextColor="Black"
                    FontSize="26"
                    FontAttributes="Bold" />

                <Button
                    Text="Remover Medicamento"
                    Command="{Binding BotaoRemoverMedicamento}"
                    HeightRequest="75"
                    CornerRadius="18"
                    BackgroundColor="White"
                    TextColor="Black"
                    FontSize="26"
                    FontAttributes="Bold" />

                <Button
                    Text="Visualizar Estoque"
                    Command="{Binding BotaoVisualizarEstoque}"
                    HeightRequest="75"
                    CornerRadius="18"
                    BackgroundColor="White"
                    TextColor="Black"
                    FontSize="26"
                    FontAttributes="Bold" />

            </VerticalStackLayout>
        </Border>

        <Frame
            WidthRequest="110"
            HeightRequest="110"
            CornerRadius="55"
            BackgroundColor="White"
            HasShadow="False"
            Padding="8"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="0,30,35,0">

            <Image Source="logopng.png" Aspect="AspectFit" />
        </Frame>
    </Grid>
</ContentPage>
